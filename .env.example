@'
# ==========================================
# ESTELYA SaaS
# Environment Template
# ==========================================

APP_NAME=Estelya
APP_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=estelya
POSTGRES_USER=estelya
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=estelya
RABBITMQ_PASSWORD=CHANGE_ME

# n8n
N8N_HOST=localhost
N8N_PORT=5678

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=3000
'@ | Set-Content .env.example -Encoding UTF8
